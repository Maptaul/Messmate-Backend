# Vercel reads this instead of .gitignore, so the .gitignore entries are
# repeated here. dist/ is intentionally absent: vercel.json points at the
# bundle, and a `builds` array means the platform never runs the build script,
# so `pnpm build` has to run locally before `vercel --prod`.
node_modules
.env
.env.*
!.env.example

/src/generated

yarn.lock
package-lock.json

.vscode
.idea
.vercel

# Vercel resolves pnpm from the lockfile version and lands on pnpm 9, which
# reads any pnpm-workspace.yaml as a workspace definition and refuses to install
# without a `packages` field. It has no job to do on the build machine.
pnpm-workspace.yaml
