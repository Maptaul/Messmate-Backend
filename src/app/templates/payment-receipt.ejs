<%
  var period = monthName + ' ' + year;
  var rows = [{ k: 'Method', v: methodLabel }];
  if (trxId && trxId !== '-') rows.push({ k: 'Reference', v: trxId });
  rows.push({ k: 'Invoice', v: invoice });
  rows.push({ k: 'Paid at', v: paidAt });
  rows.push({ k: 'Bill total', v: '৳' + totalPayable });
  rows.push({ k: 'Paid so far', v: '৳' + paidSoFar, credit: true });
  rows.push({ k: 'Remaining due', v: '৳' + dueAmount, strong: true, credit: isFullySettled });
%>
<%- include('partials/email', {
  tone: 'g',
  icon: '✅',
  messLine: messName,
  preheader: isFullySettled
    ? 'Your ' + period + ' bill is settled.'
    : '৳' + dueAmount + ' is still due for ' + period + '.',
  heading: isCash ? 'Cash payment recorded' : 'Payment received, thank you',
  paras: [isFullySettled
    ? 'Hi ' + userName + ', your ' + period + ' bill for ' + messName + ' is now settled. The receipt is attached.'
    : 'Hi ' + userName + ', we got your payment for ' + period + '. ৳' + dueAmount + ' is still due. Pay it any time from your bills page. The receipt is attached.'],
  big: '৳' + paidNow,
  bigLabel: 'Paid',
  bigTone: 'g',
  rows: rows,
  why: 'Sent for every payment on your bill.'
}) %>
