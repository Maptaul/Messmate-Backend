<%
  var day = new Date(planDate + 'T00:00:00Z').toLocaleDateString('en-GB', {
    weekday: 'long', day: 'numeric', month: 'short', timeZone: 'UTC'
  });
  var count = members.length + (members.length === 1 ? ' member' : ' members');
  var defaults = members.filter(function (member) { return member.isDefault; }).length;
%>
<%- include('partials/email', {
  tone: 'g',
  icon: '👨‍🍳',
  messLine: messName,
  preheader: 'Plans locked at 11:00 PM. ' + defaults + ' on their default meals.',
  heading: day + ' — who’s eating',
  paras: ['Hi ' + userName + ', plans locked at 11:00 PM. Share this with the cook.'],
  steps: [
    { k: 'Lunch', v: String(lunch), n: count, good: true },
    { k: 'Dinner', v: String(dinner), n: count, good: true }
  ],
  rows: members.map(function (member) {
    return {
      k: member.name,
      v: 'L ' + member.lunch + ' · D ' + member.dinner + ' · ' + (member.isDefault ? 'default' : 'planned')
    };
  }),
  note: 'Members marked default didn’t set a plan, so their usual meals were counted.',
  noteTone: 'n',
  why: 'Sent to managers every night at 11:05 PM.'
}) %>
