<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>Password Reset</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
        box-sizing: border-box;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      }

      .header {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        padding: 35px 30px;
        text-align: center;
        color: #ffffff;
      }

      .logo {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      .header p {
        margin: 0;
        font-size: 14px;
        opacity: 0.9;
      }

      .content {
        padding: 40px 35px;
      }

      .content h1 {
        margin: 0 0 15px;
        font-size: 25px;
        color: #111827;
      }

      .content p {
        font-size: 15px;
        line-height: 1.7;
        color: #6b7280;
        margin: 0 0 20px;
      }

      .otp-box {
        margin: 30px 0;
        padding: 22px;
        text-align: center;
        background: #f5f3ff;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
      }

      .otp-label {
        display: block;
        margin-bottom: 10px;
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .otp {
        font-size: 36px;
        font-weight: 700;
        letter-spacing: 10px;
        color: #4f46e5;
        margin-left: 10px;
      }

      .warning {
        padding: 15px;
        background: #fff7ed;
        border-left: 4px solid #f97316;
        border-radius: 6px;
        font-size: 13px;
        line-height: 1.6;
        color: #9a3412;
      }

      .footer {
        padding: 25px 35px;
        background: #f9fafb;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        margin: 5px 0;
        font-size: 12px;
        line-height: 1.6;
        color: #9ca3af;
      }

      @media (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 30px 22px;
        }

        .header {
          padding: 30px 20px;
        }

        .footer {
          padding: 20px;
        }

        .content h1 {
          font-size: 22px;
        }

        .otp {
          font-size: 30px;
          letter-spacing: 7px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <div class="logo">MessMate</div>
          <p>Password Reset Request</p>
        </div>

        <!-- Content -->
        <div class="content">
          <h1>Reset your password 🔐</h1>

          <p>
            We received a request to reset the password associated with your
            account.
          </p>

          <p>
            Use the verification code below to continue resetting your password:
          </p>

          <!-- OTP -->
          <div class="otp-box">
            <span class="otp-label">Your verification code</span>
            <div class="otp"><%= otp %></div>
          </div>

          <div class="warning">
            <strong>Important:</strong>
            This code will expire in <%= expirationTime %>. Never share this
            code with anyone, including our support team.
          </div>

          <p style="margin-top: 25px">
            If you didn't request a password reset, you can safely ignore this
            email. Your account will remain secure.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            © <%= new Date().getFullYear() %> MessMate. All rights reserved.
          </p>
          <p>
            This is an automated email. Please do not reply to this message.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
