<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .email-wrapper {
        width: 100%;
        background-color: #f4f7fb;
        padding: 30px 0;
      }

      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
      }

      .header {
        background: linear-gradient(135deg, #0f766e, #14b8a6);
        padding: 30px 24px;
        text-align: center;
      }

      .logo {
        display: inline-block;
        font-size: 28px;
        font-weight: bold;
        color: #ffffff;
        letter-spacing: 1px;
      }

      .content {
        padding: 40px 30px 30px;
        text-align: center;
      }

      .icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #ecfdf5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
      }

      h1 {
        margin: 0 0 16px;
        font-size: 28px;
        color: #111827;
      }

      p {
        margin: 0 0 18px;
        font-size: 16px;
        line-height: 1.7;
        color: #4b5563;
      }

      .btn {
        display: inline-block;
        margin-top: 10px;
        padding: 14px 28px;
        background-color: #0f766e;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 10px;
        font-weight: bold;
      }

      .footer {
        background: #f8fafc;
        padding: 24px 30px;
        text-align: center;
        font-size: 13px;
        color: #6b7280;
      }

      .footer a {
        color: #0f766e;
        text-decoration: none;
      }

      @media only screen and (max-width: 620px) {
        .content {
          padding: 30px 18px 24px;
        }

        h1 {
          font-size: 24px;
        }
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <div class="header">
          <div class="logo">MessMate+</div>
        </div>

        <div class="content">
          <div class="icon">✓</div>
          <h1>Password Reset Successful</h1>
          <p>
            Hello <strong><%= userName || 'there' %></strong>,
          </p>
          <p>
            Your password has been successfully reset. You can now sign in with your new password and continue using your account securely.
          </p>
          <p>
            If you did not request this change, please contact our support team immediately for assistance.
          </p>
          <a href="<%= loginUrl || '#' %>" class="btn">Go to Login</a>
        </div>

        <div class="footer">
          Need help? <a href="mailto:support@mess managementplus.com">support@mess managementplus.com</a><br />
          © 2025 MessMate+. All rights reserved.
        </div>
      </div>
    </div>
  </body>
</html>

