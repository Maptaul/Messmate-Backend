<%
  var day = new Date(planDate + 'T00:00:00Z').toLocaleDateString('en-GB', {
    weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC'
  });
%>
<%- include('partials/email', {
  tone: 'a',
  icon: '⏰',
  messLine: messName,
  preheader: 'Plans for ' + day + ' lock at 11 PM tonight.',
  heading: 'One hour left to plan tomorrow',
  paras: [
    'Hi ' + userName + ', you haven’t set your meals for ' + day + ' at ' + messName + ', and your default is no meals.',
    'Plans lock at 11:00 PM tonight. After that the manager shops for whoever is on the list, so set it now if you are eating.'
  ],
  steps: [
    { k: 'Lunch', v: '0', n: 'Default' },
    { k: 'Dinner', v: '0', n: 'Default' }
  ],
  cta: 'Plan tomorrow’s meals',
  ctaHref: loginUrl,
  note: 'Skipping tomorrow? You can ignore this email.',
  noteTone: 'n',
  why: 'Sent at 10 PM on days you haven’t planned and have no default meals.'
}) %>
