<%
  var period = monthName + ' ' + year;
  var rows = [{ k: 'Meals ' + mealCount + ' × ৳' + mealRate, v: '৳' + mealCost }];
  if (sharedLines.length) {
    sharedLines.forEach(function (line) {
      rows.push({ k: line.label, v: '৳' + line.amount });
    });
  } else {
    rows.push({ k: 'Utilities and other shared bills', v: '৳' + sharedCost });
  }
  rows.push({ k: 'Rent share', v: '৳' + rentShare });
  if (hasAdvance) rows.push({ k: 'Next month’s deposit', v: '৳' + advanceCharged });
  if (hasOpeningBalance) {
    rows.push(openingWasOwed
      ? { k: 'Brought forward from last month', v: '৳' + openingBalance }
      : { k: 'In credit from last month', v: '−৳' + openingBalance, credit: true });
  }
  rows.push({ k: 'Total payable', v: '৳' + totalPayable, strong: true });
  if (hasDeposit) rows.push({ k: 'Deposits', v: '−৳' + depositTotal, credit: true });
  if (hasPaidExpense) rows.push({ k: 'Bazar you paid', v: '−৳' + paidExpenseTotal, credit: true });
  rows.push(owes
    ? { k: 'Due', v: '৳' + dueAmount, strong: true }
    : isOwed
      ? { k: 'The mess owes you', v: '৳' + refundAmount, strong: true, credit: true }
      : { k: 'Due', v: '৳0.00', strong: true, credit: true });
%>
<%- include('partials/email', {
  tone: 'b',
  icon: '🧾',
  messLine: messName,
  preheader: 'Meal rate ৳' + mealRate + ' · ' + mealCount + ' meals. Pay by card or bKash.',
  heading: period + ' is closed',
  paras: ['Hi ' + userName + ', the meal rate came to ৳' + mealRate + ' (৳' + totalGrocery + ' bazar ÷ ' + totalMeals + ' meals). Here’s your share. The itemised PDF is attached.'],
  big: owes ? '৳' + dueAmount : isOwed ? '৳' + refundAmount : '৳0.00',
  bigLabel: owes ? 'Amount due' : isOwed ? 'The mess owes you' : 'Settled',
  bigTone: owes ? 'a' : 'g',
  rows: rows,
  cta: owes ? 'Pay ৳' + dueAmount : 'Open MessMate',
  ctaHref: loginUrl,
  cta2: owes ? 'Paying cash? Hand it to your manager and they will record it.' : '',
  why: 'Sent to every member when a month closes.'
}) %>
