NODE_ENV=development
PORT=5000

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/messmate?schema=public"

# ---- URLs ----
# This API. bKash redirects the browser back here after checkout.
# Local:      http://localhost:5000
# Production: https://messmatebackend.vercel.app
BACKEND_URL=https://messmatebackend.vercel.app
# Allowed CORS origin for the browser client (the Assignment 7 frontend).
FRONTEND_URL=http://localhost:3000

# ---- Auth ----
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google social login (GCP) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---- Seeded accounts (created at server boot) ----
SUPER_ADMIN_NAME=MessMate Admin
SUPER_ADMIN_EMAIL=******************
SUPER_ADMIN_PASSWORD=*********

DEMO_MANAGER_NAME=Demo Mess Manager
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=

DEMO_MEMBER_NAME=Demo Member
DEMO_MEMBER_EMAIL=
DEMO_MEMBER_PASSWORD=

# ---- Redis (required: caches the bKash id/refresh token) ----
REDIS_USER=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=your-redis-host.redns.redis-cloud.com
REDIS_PORT=13528

# ---- Email (Gmail app password, not your account password) ----
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_SENDER=your-gmail@gmail.com

# ---- Cloudinary (image upload: avatars, expense receipts) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- bKash tokenized checkout (public sandbox credentials) ----
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
# Must match BACKEND_URL. Left on localhost in production the payment is taken
# and never settled, because bKash sends the browser somewhere it cannot reach.
# Local:      http://localhost:5000/api/v1
# Production: https://messmatebackend.vercel.app/api/v1
BKASH_CALLBACK_URL=https://messmatebackend.vercel.app/api/v1
