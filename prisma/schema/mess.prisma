model Mess {
  id String @id @default(uuid())

  name        String  @db.VarChar(120)
  address     String  @db.VarChar(300)
  monthlyRent Decimal @db.Decimal(12, 2)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managerId String
  manager   User   @relation("MessManager", fields: [managerId], references: [id], onUpdate: Cascade)

  members MessMember[]
  cycles  BillingCycle[]

  @@index([managerId])
  @@index([isDeleted])
  @@map("messes")
}

model MessMember {
  id String @id @default(uuid())

  status   MemberStatus @default(ACTIVE)
  joinedAt DateTime     @default(now())
  leftAt   DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messId String
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  meals      MealEntry[]
  bazarDuties BazarDuty[]
  paidExpenses Expense[]   @relation("ExpensePaidBy")
  deposits   Deposit[]
  bills      MemberBill[]
  payments   Payment[]

  @@unique([messId, userId])
  @@index([messId, status])
  @@map("mess_members")
}
