model Mess {
  id String @id @default(uuid())

  name           String  @db.VarChar(120)
  address        String  @db.VarChar(300)
  monthlyRent    Decimal @db.Decimal(12, 2)
  monthlyDeposit Decimal @default(0) @db.Decimal(12, 2)

  joinCode String @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 6))")) @db.VarChar(12)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managerId String
  manager   User   @relation("MessManager", fields: [managerId], references: [id], onUpdate: Cascade)

  members   MessMember[]
  cycles    BillingCycle[]
  auditLogs AuditLog[]

  membershipRequests MembershipRequest[]

  @@index([managerId])
  @@index([isDeleted])
  @@map("messes")
}
