// Every cost of the month. GROCERY feeds the meal rate; the utility types are
// shared costs split across members; RENT is prorated by tenure, not split flat.
model Expense {
  id String @id @default(uuid())

  type        ExpenseType
  amount      Decimal     @db.Decimal(12, 2)
  splitMethod SplitMethod @default(EQUAL)
  description String?     @db.VarChar(500)
  spentAt     DateTime

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycleId String
  cycle   BillingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Who fronted the cash. Credited back to them at settlement.
  paidByMemberId String?
  paidByMember   MessMember? @relation("ExpensePaidBy", fields: [paidByMemberId], references: [id])

  createdById String
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([cycleId, type])
  @@index([cycleId, isDeleted])
  @@map("expenses")
}
