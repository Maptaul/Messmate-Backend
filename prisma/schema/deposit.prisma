model Deposit {
  id String @id @default(uuid())

  amount Decimal @db.Decimal(12, 2)
  note   String? @db.VarChar(500)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycleId String
  cycle   BillingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  memberId String
  member   MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdById String
  createdBy   User   @relation("DepositCreatedBy", fields: [createdById], references: [id])

  @@index([cycleId, memberId])
  @@index([cycleId, isDeleted])
  @@map("deposits")
}
