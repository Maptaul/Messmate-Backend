// One billing cycle = one calendar month of one mess.
// OPEN while meals and expenses are recorded, CLOSED once the settlement has run.
model BillingCycle {
  id String @id @default(uuid())

  year   Int
  month  Int // 1 - 12
  status CycleStatus @default(OPEN)

  // Filled in by the settlement at close time. Null while the cycle is OPEN.
  totalMeals   Int?
  totalGrocery Decimal? @db.Decimal(12, 2)
  mealRate     Decimal? @db.Decimal(12, 4) // a rate needs more precision than a total
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messId String
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  closedById String?
  closedBy   User?   @relation("CycleClosedBy", fields: [closedById], references: [id])

  meals       MealEntry[]
  expenses    Expense[]
  deposits    Deposit[]
  bazarDuties BazarDuty[]
  bills       MemberBill[]

  @@unique([messId, year, month])
  @@index([messId, status])
  @@map("billing_cycles")
}

// Whose turn it is to do the bazar. Duty is separate from who paid — the money
// side lives on Expense.paidByMemberId.
model BazarDuty {
  id String @id @default(uuid())

  startDate DateTime
  endDate   DateTime
  note      String?  @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycleId String
  cycle   BillingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  memberId String
  member   MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cycleId, startDate])
  @@map("bazar_duties")
}
