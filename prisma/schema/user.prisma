model User {
  id String @id @default(uuid())

  name         String       @db.VarChar(120)
  email        String
  phone        String?      @db.VarChar(20)
  password     String?
  googleId     String?      @unique
  authProvider AuthProvider @default(CREDENTIAL)
  role         Role         @default(MEMBER)
  status       UserStatus   @default(ACTIVE)
  avatarUrl    String?      @db.VarChar(500)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedMesses  Mess[]         @relation("MessManager")
  memberships    MessMember[]
  closedCycles   BillingCycle[] @relation("CycleClosedBy")
  createdExpenses Expense[]     @relation("ExpenseCreatedBy")
  createdDeposits Deposit[]     @relation("DepositCreatedBy")
  auditLogs      AuditLog[]     @relation("AuditActor")

  @@unique([email])
  @@index([role])
  @@index([isDeleted])
  @@map("users")
}
