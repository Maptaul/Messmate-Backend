// What a member says they will eat, declared ahead of the cutoff.
//
// Kept apart from MealEntry because the two answer different questions and have
// different owners. A plan is the member saying "count me in for dinner on the
// 4th", made the night before so the manager knows how much to cook and buy.
// MealEntry is the manager recording what was actually eaten, and that is what
// the settlement charges for. Merging them would let a declaration silently
// become a charge, or a correction silently rewrite what someone asked for.
model MealPlan {
  id String @id @default(uuid())

  date   DateTime @db.Date
  lunch  Int      @default(0)
  dinner Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycleId String
  cycle   BillingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  memberId String
  member   MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // One declaration per member per day. Changing your mind before the cutoff
  // updates this row rather than adding a second one.
  @@unique([memberId, date])
  @@index([cycleId, date])
  @@map("meal_plans")
}
