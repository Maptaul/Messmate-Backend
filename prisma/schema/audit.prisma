// Who changed what. Written inside the transaction it describes, so an audit
// row for a rolled-back action can never exist.
model AuditLog {
  id String @id @default(uuid())

  action   AuditAction
  entity   String      @db.VarChar(60)
  entityId String

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id], onUpdate: Cascade)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
