model MealEntry {
  id String @id @default(uuid())

  date   DateTime @db.Date
  lunch  Int      @default(0)
  dinner Int      @default(0)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycleId String
  cycle   BillingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  memberId String
  member   MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([memberId, date])
  @@index([cycleId, date])
  @@index([cycleId, isDeleted])
  @@map("meal_entries")
}
