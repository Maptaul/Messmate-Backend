model Payment {
  id String @id @default(uuid())

  status   PaymentStatus @default(UNPAID)
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("BDT")

  paymentGateway        String @default("bkash")
  merchantInvoiceNumber String @unique

  bkashPaymentId String?   @unique
  bkashTrxId     String?
  payerReference String?
  paidAt         DateTime?

  gatewayResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billId String

  bill MemberBill @relation(fields: [billId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  memberId String
  member   MessMember @relation(fields: [memberId], references: [id], onUpdate: Cascade)

  @@index([billId])
  @@index([status])
  @@map("payments")
}
