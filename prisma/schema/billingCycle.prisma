// One billing cycle = one calendar month of one mess.
// OPEN while meals and expenses are recorded, CLOSED once the settlement runs.
model BillingCycle {
  id String @id @default(uuid())

  year   Int
  month  Int // 1 - 12
  status CycleStatus @default(OPEN)

  // Filled in by the settlement at close time. Null while the cycle is OPEN.
  totalMeals   Int?
  totalGrocery Decimal?  @db.Decimal(12, 2)
  mealRate     Decimal?  @db.Decimal(12, 4) // a rate needs more precision than a total
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messId String
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  closedById String?
  closedBy   User?   @relation("CycleClosedBy", fields: [closedById], references: [id])

  meals         MealEntry[]
  expenses      Expense[]
  deposits      Deposit[]
  groceryDuties GroceryDuty[]
  bills         MemberBill[]

  @@unique([messId, year, month])
  @@index([messId, status])
  @@map("billing_cycles")
}
