model BillingCycle {
  id String @id @default(uuid())

  year   Int
  month  Int
  status CycleStatus @default(OPEN)

  totalMeals   Int?
  totalGrocery Decimal?  @db.Decimal(12, 2)
  mealRate     Decimal?  @db.Decimal(12, 4)
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messId String
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  closedById String?
  closedBy   User?   @relation("CycleClosedBy", fields: [closedById], references: [id])

  meals         MealEntry[]
  mealPlans     MealPlan[]
  expenses      Expense[]
  deposits      Deposit[]
  groceryDuties GroceryDuty[]
  bills         MemberBill[]

  @@unique([messId, year, month])
  @@index([messId, status])
  @@map("billing_cycles")
}
