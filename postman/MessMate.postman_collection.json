    {
      "name": "Error cases (three role demo)",
      "description": "Every request here is expected to FAIL. The status code is in the name. This folder is the role isolation demonstration.",
      "item": [
        {
          "name": "401 - no token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "401 - garbage token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-real-token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "403 - Member calls an Admin route",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mess/all-messes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mess",
                "all-messes"
              ]
            },
            "description": "Blocked by auth(Role.ADMIN)."
          }
        },
        {
          "name": "403 - Manager calls an Admin route",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mess/all-messes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mess",
                "all-messes"
              ]
            }
          }
        },
        {
          "name": "403 - Member tries to create a mess",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Not Allowed\",\n  \"address\": \"Nowhere\",\n  \"monthlyRent\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/mess/create-mess",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mess",
                "create-mess"
              ]
            }
          }
        },
        {
          "name": "403 - Member tries to update their own mess",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monthlyRent\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/mess/update-mess/{{messId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mess",
                "update-mess",
                "{{messId}}"
              ]
            },
            "description": "Belonging to a mess is not permission to edit it. This is the second authorization layer: auth() lets the request in, checkMessAccess and the role check inside the service stop it."
          }
        },
        {
          "name": "403 - Manager B touches Manager A mess",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mess/PASTE_ANOTHER_MANAGERS_MESS_ID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mess",
                "PASTE_ANOTHER_MANAGERS_MESS_ID"
              ]
            },
            "description": "Register a second manager, create a mess with them, then paste that mess id here. checkMessAccess returns 403 - the whole point of the second authorization layer."
          }
        },
        {
          "name": "400 - validation, field by field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Returns every failing rule as a separate { field, message } entry in `errors`, not just the first one."
          }
        },
        {
          "name": "400 - role escalation blocked at the schema",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fake Admin\",\n  \"email\": \"fake.admin@example.com\",\n  \"password\": \"Fake@pass123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "ADMIN is absent from the register enum, so no request can create one. Admins exist only through the seeder."
          }
        },
        {
          "name": "404 - mess that does not exist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mess/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mess",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          }
        },
        {
          "name": "409 - add the same member twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messId\": \"{{messId}}\",\n  \"email\": \"{{memberEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/member/add-member",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "member",
                "add-member"
              ]
            },
            "description": "Send this twice. The second call returns 409."
          }
        },
        {
          "name": "400 - admin cannot be a mess member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messId\": \"{{messId}}\",\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/member/add-member",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "member",
                "add-member"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "description": "Run last. Removes the demo mess created at the top of the collection.",
      "item": [
        {
          "name": "Remove member (Manager)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/member/remove-member/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "member",
                "remove-member",
                "{{memberId}}"
              ]
            },
            "description": "Sets status LEFT with leftAt rather than deleting, so their meals and expenses stay attached to the months they belong to and rent stays prorated to the day they left.\n\nRefuses with 409 if they still have an unpaid bill. Writes a MEMBER_REMOVED audit row inside the same transaction.\n\nKept in Cleanup on purpose: it sets the member to LEFT, and the duplicate-add case in Error cases expects them to still be ACTIVE. Running it earlier turns that 409 into a 201, because re-adding someone who left restores their old membership row instead of conflicting."
          }
        },
        {
          "name": "Delete mess (soft)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mess/delete-mess/{{messId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mess",
                "delete-mess",
                "{{messId}}"
              ]
            },
            "description": "Sets isDeleted and deletedAt - the row stays in the database. Refuses with 409 while any billing cycle is still OPEN, because deleting would strand every meal and expense recorded in it.\n\nKept last on purpose: it soft-deletes the mess that every Mess and Member request above depends on, so running it earlier makes the rest of the collection return 404."
          }
        }
      ]
    }
  ]
}