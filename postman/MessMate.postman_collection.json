            "body": {
              "mode": "raw",
              "raw": "{\n  \"messId\": \"{{messId}}\",\n  \"email\": \"{{memberEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/member/add-member",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "member",
                "add-member"
              ]
            },
            "description": "Adds an existing registered user by email.\n\nIf that person left this mess before, the original membership row is restored rather than a second one being inserted - the unique constraint on (messId, userId) means the old row still holds the slot. joinedAt resets, because rent is prorated from it.\n\nSaves `memberId` automatically."
          }
        },
        {
          "name": "Get mess members - filter and search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const managerEmail = pm.collectionVariables.get('managerEmail');",
                  "// data[0] is the manager, who cannot be removed from their own mess.",
                  "const removable = (res?.data ?? []).find(m => m.user?.email !== managerEmail);",
                  "if (removable) {",
                  "  pm.collectionVariables.set('memberId', removable.id);",
                  "  console.log('memberId saved:', removable.id);",
                  "} else {",
                  "  console.log('no removable member found - run Add member first');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/member/mess-members/{{messId}}?page=1&limit=10&status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "member",
                "mess-members",
                "{{messId}}"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "searchTerm",
                  "value": "member",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "joinedAt",
                  "disabled": true
                },
                {
                  "key": "sortOrder",
                  "value": "asc",
                  "disabled": true
                }
              ]
            },
            "description": "Filter by status (ACTIVE or LEFT), search across member name and email, sort and paginate."
