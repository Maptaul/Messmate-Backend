              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                },
                {
                  "key": "searchTerm",
                  "value": "chattogram",
                  "disabled": true
                },
                {
                  "key": "managerId",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Admin only. Supports pagination, search across name and address, filtering by managerId, and sorting. Returns `meta` with page, limit, total and totalPages."
          }
        },
        {
          "name": "Get my messes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mess/my-messes?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mess",
                "my-messes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "A manager sees what they run; a member sees where they live. Same endpoint, different result per role."
          }
        },
