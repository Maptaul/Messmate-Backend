{
	"name": "messmate-backend",
	"version": "1.0.0",
	"description": "MessMate - Smart Mess & Shared Housing Management Platform (Backend API)",
	"main": "src/server.ts",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "prisma generate && tsup",
		"start": "tsx src/server.ts",
		"typecheck": "tsc --noEmit",
		"postinstall": "prisma generate",
		"check:settlement": "tsx scripts/check-settlement.ts",
		"test": "node --import tsx --test \"tests/**/*.test.ts\"",
		"test:postman": "pnpx newman run postman/MessMate.postman_collection.json",
		"test:postman:local": "pnpx newman run postman/MessMate.postman_collection.json --env-var baseUrl=http://localhost:5000",
		"check:all": "pnpm typecheck && pnpm lint:check && pnpm check:settlement && pnpm test",
		"format:check": "pnpx @biomejs/biome format ./src",
		"format:fix": "pnpx @biomejs/biome format --write ./src",
		"lint:check": "pnpx @biomejs/biome lint ./src",
		"lint:fix": "pnpx @biomejs/biome lint --write ./src"
	},
	"keywords": [
		"mess",
		"meal",
		"expense",
		"bkash",
		"express",
		"prisma"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"bcryptjs": "^3.0.3",
		"cloudinary": "^2.11.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"ejs": "^6.0.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"google-auth-library": "^11.0.0",
		"helmet": "^8.3.0",
		"http-status": "^2.1.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.3.0",
		"node-cron": "^4.6.0",
		"nodemailer": "^9.1.1",
		"pdfkit": "^0.20.2",
		"pg": "^8.22.0",
		"prisma": "^7.9.1",
		"rate-limit-redis": "^6.0.1",
		"redis": "^6.2.0",
		"stripe": "^22.6.2",
		"tsx": "^4.23.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.1.2",
		"@types/nodemailer": "^8.0.1",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.20.0",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22"
	}
}
