{
  "version": 2,
  "regions": [
    "sin1"
  ],
  "builds": [
    {
      "src": "dist/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/app/templates/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/meal-plan-reminder",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/v1/cron/meal-headcount",
      "schedule": "5 17 * * *"
    },
    {
      "path": "/api/v1/cron/unpaid-bill-reminder",
      "schedule": "0 4 * * 1"
    }
  ]
}
